# AIOps Agent 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# Agent Identity 配置
AGENT_IDENTITY_ENDPOINT=https://coding.dashscope.aliyuncs.com/apps/anthropic
AGENT_IDENTITY_REGION=cn-hangzhou
WORKLOAD_IDENTITY_ARN=acs:agent-identity::1234567890:workload-identity/aiops-agent

# LLM Provider API Keys（通过 Agent Identity Token Vault 管理，此处仅用于本地开发）
QWEN_API_KEY=
CLAUDE_API_KEY=
GPT_API_KEY=

# 可观测性 — SLS 配置
SLS_ENDPOINT=cn-hangzhou.log.aliyuncs.com
SLS_PROJECT=aiops-agent-logs
SLS_LOGSTORE=agent-audit

# ActionTrail 配置
ACTION_TRAIL_ENABLED=true

# 日志级别
LOG_LEVEL=INFO

# 数据区域限制
DATA_RESIDENCY_REGION=cn-hangzhou
